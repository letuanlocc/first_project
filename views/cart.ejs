<%
    const cartItemsList = typeof cartItems !== 'undefined' && Array.isArray(cartItems)
        ? cartItems
        : [];
    const cartTotal = cartItemsList.reduce((total, item) => {
        const price = Number(item.price_at_that_time);
        const quantity = Number(item.quantity);
        return total + (Number.isFinite(price) && Number.isFinite(quantity) ? price * quantity : 0);
    }, 0);
    const formatPrice = value => `${Number(value).toLocaleString('vi-VN')}đ`;
%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giỏ hàng - PhoneShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/user.css">
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body>
    <%- include('partials/header', { active: 'cart' }) %>

    <main class="page">
        <nav class="breadcrumb" aria-label="Đường dẫn">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span class="current">Giỏ hàng</span>
        </nav>

        <h1 class="page-title">Giỏ hàng của bạn</h1>

        <% if (cartItemsList.length > 0) { %>
            <div class="cart-layout">
                <section class="cart-items" aria-label="Sản phẩm trong giỏ hàng">
                    <div class="cart-items-heading">
                        <h2>Sản phẩm</h2>
                        <span><%= cartItemsList.length %> sản phẩm</span>
                    </div>

                    <% cartItemsList.forEach(item => { %>
                        <% const product = item.Product; %>
                        <% const quantity = Number(item.quantity); %>
                        <% const price = Number(item.price_at_that_time); %>
                        <% const lineTotal = Number.isFinite(quantity) && Number.isFinite(price) ? quantity * price : 0; %>
                        <article class="cart-item">
                            <a class="cart-item-image" href="<%= product && product.slug ? `/${product.slug}` : '/' %>">
                                <% if (product && product.image_url) { %>
                                    <img src="<%= product.image_url %>" alt="<%= product.name %>">
                                <% } else { %>
                                    <span>Không có ảnh</span>
                                <% } %>
                            </a>

                            <div class="cart-item-details">
                                <h3>
                                    <% if (product) { %>
                                        <a href="<%= product.slug ? `/${product.slug}` : '/' %>"><%= product.name %></a>
                                    <% } else { %>
                                        Sản phẩm không còn khả dụng
                                    <% } %>
                                </h3>
                                <p class="cart-item-unit-price">
                                    Đơn giá: <%= Number.isFinite(price) ? formatPrice(price) : 'Chưa có giá' %>
                                </p>
                            </div>

                            <% if (product) { %>
                                <div class="qty-stepper" role="group" aria-label="Số lượng <%= product.name %>">
                                    <button type="button" class="remove-cart-item" data-product-id="<%= item.product_id %>" aria-label="Giảm một sản phẩm">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
                                    </button>
                                    <span class="qty-value"><%= Number.isFinite(quantity) ? quantity : 0 %></span>
                                    <button type="button" class="add-cart-item" data-product-id="<%= item.product_id %>" aria-label="Tăng thêm một sản phẩm">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>
                                </div>
                            <% } %>

                            <strong class="cart-item-total"><%= formatPrice(lineTotal) %></strong>
                        </article>
                    <% }) %>

                    <a class="continue-shopping" href="/">← Tiếp tục mua sắm</a>
                </section>

                <aside class="cart-summary">
                    <h2>Tóm tắt đơn hàng</h2>
                    <div class="cart-summary-row">
                        <span>Tạm tính</span>
                        <strong><%= formatPrice(cartTotal) %></strong>
                    </div>
                    <div class="cart-summary-row cart-summary-note">
                        <span>Phí vận chuyển</span>
                        <span>Xác nhận khi đặt hàng</span>
                    </div>
                    <div class="cart-summary-total">
                        <span>Tổng tiền</span>
                        <strong><%= formatPrice(cartTotal) %></strong>
                    </div>
                    <a class="btn btn-primary btn-lg checkout-button" href="/checkout">
                        Tiến hành đặt hàng
                    </a>
                </aside>
            </div>
        <% } else { %>
            <section class="empty-cart">
                <div class="empty-cart-icon" aria-hidden="true">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 8H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
                </div>
                <h2>Giỏ hàng đang trống</h2>
                <p>Hãy khám phá các sản phẩm và chọn món đồ bạn yêu thích.</p>
                <a class="btn btn-primary btn-lg" href="/">Khám phá sản phẩm</a>
            </section>
        <% } %>
    </main>
<script src="/js/user.js"></script>
</body>
</html>
