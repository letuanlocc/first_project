
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Page</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="container">

    <!-- Header -->
    <div class="header">
        <div>
            <h1>Admin Page</h1>
            <p>Quản lý danh mục và sản phẩm</p>
        </div>

        <form class="logout" action="/logout" method="POST">
            <button type="submit">Đăng xuất</button>
        </form>
    </div>


    <!-- Thêm danh mục -->
    <div class="card">
        <h2>Thêm danh mục</h2>
        <form>

            <div class="form-group">
                <label for="categoryName">Tên danh mục</label>

                <input
                    type="text"
                    id="categoryName"
                    name="name"
                    placeholder="Nhập tên danh mục"
                    required
                >
            </div>

            <button class="btn btn-category" type="submit" id="addCategoryBtn">
                + Thêm danh mục
            </button>
            <button class="btn btn-category" type="submit" id="deleteCategoryBtn">
                + Xóa danh mục
            </button>

        </form>
    </div>


    <!-- Thêm sản phẩm -->
    <div class="card">
        <h2>Thêm sản phẩm</h2>
        <form>
            <div class="form-group">
                <label for="productName">Tên sản phẩm</label>

                <input
                    type="text"
                    id="productName"
                    name="name"
                    placeholder="Nhập tên sản phẩm"
                    required
                >
            </div>


            <div class="form-group">
                <label for="price">Giá</label>

                <input
                    type="number"
                    id="price"
                    name="price"
                    placeholder="Nhập giá sản phẩm"
                    min="0"
                    required
                >
            </div>


            <div class="form-group">
                <label for="description">Mô tả</label>

                <textarea
                    id="description"
                    name="description"
                    placeholder="Nhập mô tả sản phẩm"
                ></textarea>
            </div>


            <div class="form-group">
                <label for="image">Ảnh sản phẩm</label>

                <input 
                    type="file"
                    id="image"
                    name="image"
                    accept="image/*"
                >
                
            </div>


            <div class="form-group">
                <label for="category">Danh mục</label>

                <select name="category" id="category" required>

                    <option value="">
                        -- Chọn danh mục --
                    </option>

                    <% Categories.forEach(Category => { %>

                        <option value="<%= Category._id %>">
                            <%= Category.name %>
                        </option>

                    <% }) %>

                </select>
            </div>


            <div class="form-group">
                <label for="stock">Số lượng</label>

                <input
                    type="number"
                    id="stock"
                    name="stock"
                    placeholder="Nhập số lượng"
                    min="0"
                    value="0"
                >
            </div>


            <button class="btn btn-product" type="button" id= "addProductBtn">
                + Thêm sản phẩm
            </button>
             <button class="btn btn-product" type="button" id="searchProductBtn">
                + Tìm sản phẩm
            </button>
             <button class="btn btn-product" type="button" id="updateProductBtn">
                + Cập nhật sản phẩm
            </button>
            <button class="btn btn-product" type="button" id="deleteProductBtn">
                + Xóa sản phẩm
            </button>
            <button class = "btn btn-product" type= "button" id="viewProductBtn">    
                + Xem tất cả sản phẩm
            </button>
        </form>
    </div>
    <div id="productTableContainer" style="display: none; margin-top: 20px; overflow-x: auto;">
            <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background-color: #f2f2f2;">
                        <th>ID</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    <!-- Dữ liệu sản phẩm từ JS sẽ được đổ vào đây sau -->
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Alert -->
<script>
    const error = "<%= error || '' %>";
    const success = "<%= success || '' %>";

    if (success) {
        alert(success);
    }

    if (error) {
        alert(error);
    }
</script>
<script src="/js/admin.js"></script>
</body>
</html>
