<%
    const headerCategories = Array.isArray(locals.Categories) ? locals.Categories : [];
    const headerUser = locals.user || null;
    const headerSearch = locals.search || '';
    const headerActive = locals.active || '';
%>
<header class="site-header">
    <div class="site-header-inner">
        <a href="/" class="logo" aria-label="PhoneShop - Trang chủ">
            <span class="logo-mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18h2"/></svg>
            </span>
            <span>Phone<span class="logo-accent">Shop</span></span>
        </a>

        <div class="category-dropdown">
            <button class="header-btn" type="button" aria-haspopup="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span>Danh mục</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="category-list">
                <% headerCategories.forEach(category => { %>
                    <a href="/category/<%= category.id %>"><%= category.name %></a>
                <% }) %>
            </div>
        </div>

        <form class="search-box" id="product-search-form" action="/" method="GET">
            <input type="text" id="product-search-input" name="search" value="<%= headerSearch %>" placeholder="Bạn muốn mua gì hôm nay?" aria-label="Tìm kiếm sản phẩm">
            <button type="submit" aria-label="Tìm kiếm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            </button>
        </form>

        <a href="/cart" class="header-btn" <%= headerActive === 'cart' ? 'aria-current=page' : '' %>>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 8H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
            <span>Giỏ hàng</span>
        </a>

        <% if (headerUser) { %>
            <div class="user-menu">
                <a href="/profile" class="user-link" aria-label="Tài khoản của tôi">
                    <span class="user-avatar" aria-hidden="true"><%= String(headerUser.userName || '?').trim().charAt(0).toUpperCase() %></span>
                    <span class="user-name"><%= headerUser.userName %></span>
                </a>
                <form action="/logout" method="POST">
                    <button type="submit" class="link-btn">Đăng xuất</button>
                </form>
            </div>
        <% } else { %>
            <div class="auth-links">
                <a href="/login" class="btn btn-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
                    Đăng nhập
                </a>
                <a href="/register" class="link-btn">Đăng ký</a>
            </div>
        <% } %>
    </div>
</header>
