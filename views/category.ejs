<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= result.name %> - PhoneShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/user.css">
    <link rel="stylesheet" href="/css/category.css">
</head>

<body id="top">
    <%- include('partials/header') %>

    <main class="page">
        <nav class="breadcrumb" aria-label="Đường dẫn">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span class="current"><%= result.name %></span>
        </nav>

        <h1 class="page-title"><%= result.name %></h1>

        <h2 class="section-title">Chọn theo tiêu chí</h2>
        <div class="filter-list">
            <button class="filter-btn active" type="button">Bộ lọc</button>
            <button class="filter-btn" type="button">Sẵn hàng</button>
            <button class="filter-btn" type="button">Hàng mới về</button>
            <button class="filter-btn" type="button">Xem theo giá</button>
            <button class="filter-btn" type="button">Bộ nhớ trong</button>
            <button class="filter-btn" type="button">Dung lượng RAM</button>
            <button class="filter-btn" type="button">Kích thước màn hình</button>
        </div>

        <div class="sort-header">
            <h2 class="section-title">Sắp xếp theo</h2>
            <div class="sort-list">
                <button class="sort-btn active" type="button">Phổ biến</button>
                <button class="sort-btn" type="button">Giá thấp - cao</button>
                <button class="sort-btn" type="button">Giá cao - thấp</button>
            </div>
        </div>

        <div class="product-grid">
            <% if (result.Products && result.Products.length > 0) { %>

                <% result.Products.forEach(product => { %>
                    <article class="product-card">
                        <a href="/<%= product.slug %>" class="product-image" aria-label="<%= product.name %>">
                            <img src="<%= product.image_url %>" alt="<%= product.name %>">
                        </a>

                        <div class="product-info">
                            <a href="/<%= product.slug %>" class="product-name"><%= product.name %></a>

                            <div class="product-price">
                                <%= product.price == null || String(product.price).trim() === '' || !Number.isFinite(Number(product.price))
                                    ? 'Giá liên hệ'
                                    : `${Number(product.price).toLocaleString('vi-VN')}đ` %>
                            </div>

                            <div class="product-bottom">
                                <span class="rating">
                                    <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><polygon points="12 3 14.7 9 21 9.6 16.2 13.8 17.7 20 12 16.8 6.3 20 7.8 13.8 3 9.6 9.3 9"/></svg>
                                    5
                                </span>
                                <button class="favorite" type="button" aria-pressed="false" aria-label="Yêu thích">
                                    <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10A4.5 4.5 0 0 1 12 7.8 4.5 4.5 0 0 1 19.5 10.5c0 5.4-7.5 10-7.5 10z"/></svg>
                                </button>
                            </div>
                        </div>
                    </article>
                <% }) %>

            <% } else { %>
                <div class="no-products">Không có sản phẩm nào trong danh mục này.</div>
            <% } %>
        </div>
    </main>

    <%- include('partials/floating') %>
<script src="/js/user.js"></script>
</body>
</html>
