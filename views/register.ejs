
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký</title>
</head>
<body>

    <h1>Đăng ký</h1>

    <form action="/register" method="POST">

        <div>
            <label for="name">Tên</label>
            <input
                type="text"
                id="name"
                name="username"
                required
            >
        </div>

        <div>
            <label for="email">Email</label>
            <input
                type="email"
                id="email"
                name="email"
                required
            >
        </div>

        <div>
            <label for="password">Mật khẩu</label>
            <input
                type="password"
                id="password"
                name="password"
                required
            >
        </div>

        <div>
            <label for="confirmPassword">Nhập lại mật khẩu</label>
            <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
            >
        </div>

        <button type="submit">Đăng ký</button>

    </form>

    <p>
        Đã có tài khoản?
        <a href="/login">Đăng nhập</a>
    </p>

</body>
</html>