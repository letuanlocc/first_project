<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phone Shop</title>
    <link rel="stylesheet" href="/css/user.css">
</head>

<body>

    <!-- HEADER -->
    <header class="header">
        <div class="header-container">

            <!-- Logo -->
            <a href="/" class="logo">
                Phone<span>Shop</span>
            </a>

            <!-- Danh mục -->
            <div class="category-dropdown">
                <button class="category-btn">
                    ☰
                    <span>Danh mục</span>
                </button>
                <div class="category-list">
                    <% Categories.forEach(Category => { %>
                        <a href="/category/<%= Category.id %>">
                            <%= Category.name %>
                        </a>
                    <% }) %>
                </div>
            </div>
            <!-- Khu vực -->
            <button class="location-btn">
                ◉
                <span>Đà Nẵng</span>
            </button>

            <!-- Search -->
            <form class="search-box" id="product-search-form" action="/" method="GET">
                <input
                    type="text"
                    id="product-search-input"
                    name="search"
                    value="<%= search || '' %>"
                    placeholder="Bạn muốn mua gì hôm nay?"
                >
                <select id="product-search-suggestions" aria-label="Gợi ý tìm kiếm">
                    <option value="">Gợi ý</option>
                    <% searchOptions.forEach(group => { %>
                        <optgroup label="<%= group.label %>">
                            <% group.options.forEach(option => { %>
                                <option value="<%= option.value %>" <%= search === option.value ? 'selected' : '' %>>
                                    <%= option.label %>
                                </option>
                            <% }) %>
                        </optgroup>
                    <% }) %>
                </select>
                <button type="submit">⌕</button>
            </form>

            <!-- Cart -->
            <a href="/cart" class="header-link cart">
                🛒
                <span>Giỏ hàng</span>
            </a>

            <!-- Auth -->
            <% if (user) { %>

                <div class="user-menu">
                    <span class="user-icon">◯</span>
                    <span><%= user.userName %></span>

                    <form action="/logout" method="POST">
                        <button type="submit">Đăng xuất</button>
                    </form>
                </div>

            <% } else { %>

                <a href="/login" class="login-btn">
                    ◯
                    <span>Đăng nhập</span>
                </a>

            <% } %>

        </div>
    </header>


    <!-- MAIN -->
    <main class="main-container">

        <!-- SORT -->
        <div class="sort-container">

            <h2>Sắp xếp theo</h2>

            <div class="sort-buttons">

                <button class="sort-btn active">
                    ☆ Phổ biến
                </button>

                <button class="sort-btn">
                    ⚙ Khuyến mãi HOT
                </button>

                <button class="sort-btn">
                    ⇅ Giá Thấp - Cao
                </button>

                <button class="sort-btn">
                    ⇵ Giá Cao - Thấp
                </button>

            </div>

        </div>


        <!-- PRODUCTS -->
        <div class="product-grid">

            <% if (products && products.length > 0) { %>

                <% products.forEach(product => { %>

                    <% const productSpecifications = product.descriptions || []; %>
                    <% const screenSizeSpec = productSpecifications.find(spec => spec.key.includes("Kích thước màn hình")); %>
                    <% const storageSpec = productSpecifications.find(spec => spec.key.includes("Bộ nhớ trong")); %>

                    <div class="product-card">

                        <!-- Discount -->
                        <div class="discount">
                            Giảm 10%
                        </div>

                        <!-- Installment -->
                        <div class="installment">
                            Trả góp 0%
                        </div>


                        <!-- IMAGE -->
                        <a
                            href="/<%= product.slug %>"
                            class="product-image"
                        >
                            <img
                                src="<%= product.image_url %>"
                                alt="<%= product.name %>"
                            >
                        </a>


                        <!-- INFO -->
                        <div class="product-info">
                            <a
                                href="/<%= product.slug %>"
                                class="product-name"
                            >
                                <%= product.name %>
                            </a>


                            <!-- Status -->
                            <!-- <div class="product-status">
                                Hàng mới về
                            </div> -->


                            <!-- PRICE -->
                            <div class="price-row">

                                <span class="product-price">
                                    <%= product.price == null || String(product.price).trim() === '' || !Number.isFinite(Number(product.price))
                                        ? 'Giá liên hệ'
                                        : `${Number(product.price).toLocaleString('vi-VN')}đ` %>
                                </span>

                            </div>


                            <!-- Specs -->
                            <% if (screenSizeSpec || storageSpec) { %>
                                <div class="specs">
                                    <% if (screenSizeSpec) { %>
                                        <span><%= screenSizeSpec.value %></span>
                                    <% } %>
                                    <% if (storageSpec) { %>
                                        <span><%= storageSpec.value %></span>
                                    <% } %>
                                </div>
                            <% } %>


                            <!-- Promotion -->
                            <!-- <div class="promotion">
                                Smember giảm đến 300.000đ
                            </div> -->


                            <!-- Rating -->
                            <div class="product-bottom">

                                <div class="rating">
                                    <span>★</span>
                                    5
                                </div>

                                <button class="favorite">
                                    ♡
                                </button>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="no-product">
                    Không có sản phẩm nào.
                </div>

            <% } %>

        </div>

    </main>


    <!-- BACK TO TOP -->
    <button class="back-top">
        Lên đầu
        <span>⌃</span>
    </button>


    <!-- CONTACT -->
    <button class="contact">
        Liên hệ
        <span>◉</span>
    </button>

<script>
    const searchInput = document.getElementById('product-search-input');
    const searchSuggestions = document.getElementById('product-search-suggestions');
    const productSearchForm = document.getElementById('product-search-form');

    searchSuggestions.addEventListener('change', () => {
        if (searchSuggestions.value) searchInput.value = searchSuggestions.value;
    });

    productSearchForm.addEventListener('submit', () => {
        if (searchSuggestions.value) searchInput.value = searchSuggestions.value;
    });
</script>
</body>
</html>